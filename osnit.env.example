# Copy this file to "osnit.env" (same folder as run.bat) and fill in what you have.
# Lines left empty are ignored. Keep osnit.env private: it holds your API keys.

# --- Google-like web search (pick at least one) ---
# Google Programmable Search: https://programmablesearchengine.google.com  +  API key from Google Cloud
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# SerpAPI (paid, real google.com results): https://serpapi.com
SERPAPI_KEY=
# Brave Search API: https://brave.com/search/api
BRAVE_API_KEY=
# Self-hosted SearXNG (e.g. on the NAS): http://192.168.1.10:8888
SEARXNG_URL=

# --- No-API web search through a real browser (no key needed) ---
# Default in v2.0: native_meta (Playwright Stealth + Wayback CDX/API fallback).
# Legacy NodeJS provider: browser (requires 'npm install' in tools/browser_worker).
# OSNIT_PROVIDERS=native_meta

# --- Optional AI help (opt-in; e.g. Google Gemini via its OpenAI-compatible endpoint) ---
# Fill these three to use a model, then turn on the parts you want below. Nothing here is required:
# with these empty, everything runs exactly as before (stdlib only). Gemini example values shown.
OSNIT_AI_KEY=
OSNIT_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OSNIT_AI_MODEL=gemini-2.5-flash
# 1 = when searching a person's name, ask the model for all its spellings/nicknames (Hebrew, English,
# Hebrew<->English, slang) and search those too. Off -> the built-in nickname dictionary is used alone.
OSNIT_AI_NAMES=0
# 1 = let the model suggest column types on import (always shown for you to confirm; never auto-applied)
OSNIT_AI_TEMPLATE=0

# --- Behaviour ---
# Delete files after "import" / "import-db" succeeds (1 = yes)
OSNIT_DELETE_IMPORTED=0
# Where the database lives (default: data/osnit.db)
OSNIT_DB=
# Parallel page fetchers
OSNIT_WORKERS=4
