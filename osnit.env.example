# ==============================================================================
# osnit-il v2.0 — Environment & Configuration File
# ==============================================================================
# Copy this file to "osnit.env" (created automatically by install.bat / run.bat).
# Empty lines are ignored. Keep osnit.env private (it is git-ignored).

# --- 1. Native Web Search & Discovery Providers ---
# Default in v2.0: native_meta (Playwright Stealth Chromium + System Browser/HTTP Fallback + Wayback CDX).
# Works 100% out of the box with zero API keys required.
OSNIT_PROVIDERS=native_meta

# --- 2. Optional Official Search Engine APIs (fill any you have) ---
# Google Programmable Search (https://programmablesearchengine.google.com + Google Cloud API Key)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# SerpAPI (https://serpapi.com)
SERPAPI_KEY=
# Brave Search API (https://brave.com/search/api)
BRAVE_API_KEY=
# Self-hosted SearXNG instance (e.g. http://127.0.0.1:8888)
SEARXNG_URL=

# --- 3. Storage, Archive & High-Scale Performance ---
# SQLite WAL + FTS5 Database path (default: data/osnit.db)
OSNIT_DB=data/osnit.db
# Permanent SHA-256 deduplicated raw archive directory (default: data/archive)
OSNIT_ARCHIVE_DIR=data/archive
# Local AI models cache directory for DictaBERT-NER (default: data/models)
OSNIT_MODELS_DIR=data/models
# Keep imported raw files in the managed archive (0 = keep in archive, 1 = delete after import)
OSNIT_DELETE_IMPORTED=0
# Background page fetcher threads
OSNIT_WORKERS=4
# Safety confirmation code for bulk reset operations in the UI
OSNIT_RESET_CODE=1212

# --- 4. Optional External LLM Assistant (opt-in; leave empty for 100% local offline operation) ---
OSNIT_AI_KEY=
OSNIT_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OSNIT_AI_MODEL=gemini-2.5-flash
OSNIT_AI_NAMES=0
OSNIT_AI_TEMPLATE=0
